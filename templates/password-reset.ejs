<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f4f5;
    "
  >
    <table role="presentation" style="width: 100%; border-collapse: collapse">
      <tr>
        <td align="center" style="padding: 40px 0">
          <table
            role="presentation"
            style="
              width: 600px;
              max-width: 100%;
              border-collapse: collapse;
              background-color: #ffffff;
              box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
              border-radius: 12px;
            "
          >
            <!-- Header with Logo -->
            <tr>
              <td
                style="
                  text-align: center;
                  padding: 32px 40px;
                  background: #6155f5;
                  border-radius: 12px 12px 0 0;
                "
              >
                <img
                  src="https://res.cloudinary.com/dyap7epew/image/upload/v1766262243/konecticus/purple_logo_sbym0k.png"
                  alt="Koneticus Logo"
                  style="max-width: 180px; height: auto"
                />
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 40px; text-align: center">
                <!-- Title -->
                <h1
                  style="
                    margin: 0 0 24px;
                    color: #1f2937;
                    font-size: 28px;
                    font-weight: 700;
                  "
                >
                  Reset Your Password
                </h1>

                <!-- Message -->
                <p
                  style="
                    margin: 0 0 16px;
                    color: #374151;
                    font-size: 16px;
                    line-height: 1.6;
                  "
                >
                  We received a request to reset your password. Click the button
                  below to create a new password.
                </p>

                <p
                  style="
                    margin: 0 0 32px;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.6;
                  "
                >
                  This link will expire in <strong>1 hour</strong>.
                </p>

                <!-- Reset Button -->
                <a
                  href="<%= resetUrl %>"
                  style="
                    display: inline-block;
                    padding: 14px 40px;
                    background: #6155f5;
                    color: #ffffff;
                    text-decoration: none;
                    border-radius: 50px;
                    font-size: 16px;
                    font-weight: 600;
                  "
                >
                  Reset Password
                </a>

                <!-- Alternative Link -->
                <p style="margin: 32px 0 0; color: #9ca3af; font-size: 12px">
                  If the button doesn't work, copy and paste this link into your
                  browser:
                </p>
                <p
                  style="
                    margin: 8px 0 0;
                    color: #6366f1;
                    font-size: 12px;
                    word-break: break-all;
                  "
                >
                  <%= resetUrl %>
                </p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 40px">
                <hr
                  style="border: none; border-top: 1px solid #e5e7eb; margin: 0"
                />
              </td>
            </tr>

            <!-- Security Note -->
            <tr>
              <td style="padding: 24px 40px; text-align: center">
                <p style="margin: 0; color: #9ca3af; font-size: 12px">
                  If you didn't request a password reset, you can safely ignore
                  this email. Your password will remain unchanged.
                </p>
              </td>
            </tr>

            <!-- Copyright -->
            <tr>
              <td style="padding: 0 40px 24px; text-align: center">
                <p style="margin: 0; color: #6b7280; font-size: 14px">
                  Copyright © 2025 Koneticus. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
