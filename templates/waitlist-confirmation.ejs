<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Koneticus Waitlist</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f4f5;
    "
  >
    <table role="presentation" style="width: 100%; border-collapse: collapse">
      <tr>
        <td align="center" style="padding: 40px 0">
          <table
            role="presentation"
            style="
              width: 600px;
              max-width: 100%;
              border-collapse: collapse;
              background-color: #ffffff;
              box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            "
          >
            <!-- Header with Logo -->
            <tr>
              <td
                style="
                  text-align: center;
                  padding: 24px 40px;
                  background: #6155f5;
                "
              >
                <img
                  src="https://res.cloudinary.com/dyap7epew/image/upload/v1766262243/konecticus/purple_logo_sbym0k.png"
                  alt="Koneticus Logo"
                  style="max-width: 180px; height: auto"
                />
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 40px; text-align: center">
                <!-- Title -->
                <h1
                  style="
                    margin: 0 0 30px;
                    color: #1f2937;
                    font-size: 32px;
                    font-weight: 700;
                  "
                >
                  You're on the waitlist! 🎉
                </h1>

                <!-- Celebration Image -->
                <img
                  src="https://res.cloudinary.com/dyap7epew/image/upload/v1766262766/konecticus/Frame_1984078909_s8eiwr.png"
                  alt="Celebration"
                  style="
                    max-width: 100%;
                    height: auto;
                    margin-bottom: 30px;
                    border-radius: 12px;
                  "
                />

                <!-- Message -->
                <p
                  style="
                    margin: 0 0 16px;
                    color: #374151;
                    font-size: 16px;
                    line-height: 1.6;
                    text-align: left;
                  "
                >
                  Thanks for signing up. Your spot has been successfully
                  secured.
                </p>
                <p
                  style="
                    margin: 0;
                    color: #374151;
                    font-size: 16px;
                    line-height: 1.6;
                    text-align: left;
                  "
                >
                  We'll notify you as soon as access becomes available.
                </p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 40px">
                <hr
                  style="border: none; border-top: 1px solid #e5e7eb; margin: 0"
                />
              </td>
            </tr>

            <!-- Social Icons -->
            <tr>
              <td style="padding: 24px 40px; text-align: center">
                <a
                  href="https://twitter.com/koneticus"
                  style="
                    display: inline-block;
                    margin: 0 8px;
                    text-decoration: none;
                  "
                >
                  <img
                    src="https://cdn-icons-png.flaticon.com/512/733/733579.png"
                    alt="X (Twitter)"
                    style="width: 24px; height: 24px"
                  />
                </a>
                <a
                  href="https://instagram.com/koneticus"
                  style="
                    display: inline-block;
                    margin: 0 8px;
                    text-decoration: none;
                  "
                >
                  <img
                    src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png"
                    alt="Instagram"
                    style="width: 24px; height: 24px"
                  />
                </a>
              </td>
            </tr>

            <!-- Copyright -->
            <tr>
              <td style="padding: 0 40px 16px; text-align: center">
                <p style="margin: 0; color: #6b7280; font-size: 14px">
                  Copyright © 2025 koneticus. All rights reserved.
                </p>
              </td>
            </tr>

            <!-- Footer Note -->
            <tr>
              <td style="padding: 24px 40px; text-align: center">
                <p style="margin: 0 0 8px; color: #9ca3af; font-size: 12px">
                  You're getting this email because you joined our waitlist.
                </p>
                <p style="margin: 0; color: #9ca3af; font-size: 12px">
                  You can
                  <a href="#" style="color: #6366f1; text-decoration: underline"
                    >Unsubscribe</a
                  >
                  anytime if you change your mind.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
